create_library_set -name lib_max \
    -timing {/usr/cadtool/ee5216/CBDK_TSMC90GUTM_Arm_f1.0/CIC/SOCE/lib/slow.lib}

create_library_set -name lib_min \
    -timing {/usr/cadtool/ee5216/CBDK_TSMC90GUTM_Arm_f1.0/CIC/SOCE/lib/fast.lib}

create_constraint_mode -name func_mode \
    -sdc_files {./CHIP_cts.sdc}

create_delay_corner -name delay_corner_max -library_set {lib_max}
create_delay_corner -name delay_corner_min -library_set {lib_min}

create_analysis_view -name func_mode_max \
    -constraint_mode {func_mode} -delay_corner {delay_corner_max}
create_analysis_view -name func_mode_min \
    -constraint_mode {func_mode} -delay_corner {delay_corner_min}

set_analysis_view -setup {func_mode_max} -hold {func_mode_min}
