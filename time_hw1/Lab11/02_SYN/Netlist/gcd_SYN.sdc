###################################################################

# Created by write_sdc on Tue Sep 22 13:57:20 2026

###################################################################
set sdc_version 2.2

set_units -time ns -resistance kOhm -capacitance pF -voltage V -current mA
set_operating_conditions -max slow -max_library slow\
                         -min fast -min_library fast
set_wire_load_mode top
set_max_area 0
set_max_fanout 20 [current_design]
set_load -pin_load 0.005194 [get_ports {sqr_out[9]}]
set_load -pin_load 0.005194 [get_ports {sqr_out[8]}]
set_load -pin_load 0.005194 [get_ports {sqr_out[7]}]
set_load -pin_load 0.005194 [get_ports {sqr_out[6]}]
set_load -pin_load 0.005194 [get_ports {sqr_out[5]}]
set_load -pin_load 0.005194 [get_ports {sqr_out[4]}]
set_load -pin_load 0.005194 [get_ports {sqr_out[3]}]
set_load -pin_load 0.005194 [get_ports {sqr_out[2]}]
set_load -pin_load 0.005194 [get_ports {sqr_out[1]}]
set_load -pin_load 0.005194 [get_ports {sqr_out[0]}]
set_load -pin_load 0.005194 [get_ports out_valid]
create_clock [get_ports clk]  -period 5  -waveform {0 2.5}
set_clock_uncertainty 0.1  [get_clocks clk]
set_clock_transition -max -rise 0.1 [get_clocks clk]
set_clock_transition -max -fall 0.1 [get_clocks clk]
set_clock_transition -min -rise 0.1 [get_clocks clk]
set_clock_transition -min -fall 0.1 [get_clocks clk]
set_input_delay -clock clk  0  [get_ports clk]
set_input_delay -clock clk  -max 2.5  [get_ports {data_in[9]}]
set_input_delay -clock clk  -min 0  [get_ports {data_in[9]}]
set_input_delay -clock clk  -max 2.5  [get_ports {data_in[8]}]
set_input_delay -clock clk  -min 0  [get_ports {data_in[8]}]
set_input_delay -clock clk  -max 2.5  [get_ports {data_in[7]}]
set_input_delay -clock clk  -min 0  [get_ports {data_in[7]}]
set_input_delay -clock clk  -max 2.5  [get_ports {data_in[6]}]
set_input_delay -clock clk  -min 0  [get_ports {data_in[6]}]
set_input_delay -clock clk  -max 2.5  [get_ports {data_in[5]}]
set_input_delay -clock clk  -min 0  [get_ports {data_in[5]}]
set_input_delay -clock clk  -max 2.5  [get_ports {data_in[4]}]
set_input_delay -clock clk  -min 0  [get_ports {data_in[4]}]
set_input_delay -clock clk  -max 2.5  [get_ports {data_in[3]}]
set_input_delay -clock clk  -min 0  [get_ports {data_in[3]}]
set_input_delay -clock clk  -max 2.5  [get_ports {data_in[2]}]
set_input_delay -clock clk  -min 0  [get_ports {data_in[2]}]
set_input_delay -clock clk  -max 2.5  [get_ports {data_in[1]}]
set_input_delay -clock clk  -min 0  [get_ports {data_in[1]}]
set_input_delay -clock clk  -max 2.5  [get_ports {data_in[0]}]
set_input_delay -clock clk  -min 0  [get_ports {data_in[0]}]
set_input_delay -clock clk  -max 2.5  [get_ports in_valid]
set_input_delay -clock clk  -min 0  [get_ports in_valid]
set_input_delay -clock clk  0  [get_ports rst_n]
set_output_delay -clock clk  -max 2.5  [get_ports {sqr_out[9]}]
set_output_delay -clock clk  -min 0  [get_ports {sqr_out[9]}]
set_output_delay -clock clk  -max 2.5  [get_ports {sqr_out[8]}]
set_output_delay -clock clk  -min 0  [get_ports {sqr_out[8]}]
set_output_delay -clock clk  -max 2.5  [get_ports {sqr_out[7]}]
set_output_delay -clock clk  -min 0  [get_ports {sqr_out[7]}]
set_output_delay -clock clk  -max 2.5  [get_ports {sqr_out[6]}]
set_output_delay -clock clk  -min 0  [get_ports {sqr_out[6]}]
set_output_delay -clock clk  -max 2.5  [get_ports {sqr_out[5]}]
set_output_delay -clock clk  -min 0  [get_ports {sqr_out[5]}]
set_output_delay -clock clk  -max 2.5  [get_ports {sqr_out[4]}]
set_output_delay -clock clk  -min 0  [get_ports {sqr_out[4]}]
set_output_delay -clock clk  -max 2.5  [get_ports {sqr_out[3]}]
set_output_delay -clock clk  -min 0  [get_ports {sqr_out[3]}]
set_output_delay -clock clk  -max 2.5  [get_ports {sqr_out[2]}]
set_output_delay -clock clk  -min 0  [get_ports {sqr_out[2]}]
set_output_delay -clock clk  -max 2.5  [get_ports {sqr_out[1]}]
set_output_delay -clock clk  -min 0  [get_ports {sqr_out[1]}]
set_output_delay -clock clk  -max 2.5  [get_ports {sqr_out[0]}]
set_output_delay -clock clk  -min 0  [get_ports {sqr_out[0]}]
set_output_delay -clock clk  -max 2.5  [get_ports out_valid]
set_output_delay -clock clk  -min 0  [get_ports out_valid]
set_drive 1  [get_ports {data_in[9]}]
set_drive 1  [get_ports {data_in[8]}]
set_drive 1  [get_ports {data_in[7]}]
set_drive 1  [get_ports {data_in[6]}]
set_drive 1  [get_ports {data_in[5]}]
set_drive 1  [get_ports {data_in[4]}]
set_drive 1  [get_ports {data_in[3]}]
set_drive 1  [get_ports {data_in[2]}]
set_drive 1  [get_ports {data_in[1]}]
set_drive 1  [get_ports {data_in[0]}]
set_drive 1  [get_ports in_valid]
