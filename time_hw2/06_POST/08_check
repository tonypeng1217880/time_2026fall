#!/bin/bash
set -e

./09_clean_up > check.log 2>&1
set +e
./01_run_vcs_post >> check.log 2>&1
sim_status=$?
set -e

if grep -q 'PASS  |  DLL 1 GHz TEST' vcs.log; then
    echo -e "\033[0;30;42m--- 06_POST DLL 1 GHz PASS ---\033[0m"
    grep -E 'DLL lock detected|DLL absolute delay|DLL TEST PASSED' vcs.log || true
elif grep -q 'FAIL  |  DLL TEST' vcs.log || grep -i -q 'fatal' vcs.log; then
    echo -e "\033[31m--- 06_POST DLL FAIL ---\033[0m"
    grep -E 'FAIL|TIMEOUT|Fatal|Error' vcs.log | tail -40 || true
    exit 1
else
    echo -e "\033[31m--- 06_POST ended without a DLL PASS banner ---\033[0m"
    echo "Simulator exit status: $sim_status"
    tail -60 vcs.log
    exit 1
fi
