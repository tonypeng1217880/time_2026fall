# TSMC 90 nm Design Compiler setup for TIME HW2.

set search_path " . \
                  /usr/cadtool/ee5216/CBDK_TSMC90GUTM_Arm_f1.0/CIC/SynopsysDC/db \
                  $search_path"

# Map using the slow corner only; fast is the matching minimum-delay model.
# Keep slow first when resolving explicitly instantiated standard cells.
set target_library    "slow.db"
set link_library      "* $target_library fast.db dw_foundation.sldb"
set symbol_library    "generic.sdb"
set synthetic_library "dw_foundation.sldb"
set_min_library slow.db -min_version fast.db

set hdlin_ff_always_sync_set_reset true
set hdlin_translate_off_skip_text "TRUE"
set verilogout_no_tri true
set edifout_netlist_only true

set command_log_file "./command.log"
set view_command_log_file "./view_command.log"
set sh_enable_line_editing true
history keep 100
alias h history
